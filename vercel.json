{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/consent",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/news",
      "destination": "/demo/news"
    },
    {
      "source": "/news/",
      "destination": "/demo/news"
    },
    {
      "source": "/news/:slug",
      "destination": "/demo/article"
    },
    {
      "source": "/news/:slug/",
      "destination": "/demo/article"
    },
    {
      "source": "/admin",
      "destination": "/demo/admin"
    },
    {
      "source": "/admin/",
      "destination": "/demo/admin"
    },
    {
      "source": "/admin/edit.php",
      "destination": "/demo/edit"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(admin|demo)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
