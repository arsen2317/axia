# аксиа — настройки для Apache (виртуальный хостинг REG.RU и т. п.)
AddDefaultCharset UTF-8
Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# всё — по HTTPS (раскомментировать после выпуска SSL-сертификата)
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# служебные папки и файлы закрыты снаружи
RewriteRule ^(config|lib|data|tools|demo)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(README\.md|vercel\.json|composer\.(json|lock))$ - [F,L]
RewriteRule \.(md|log|bak|swp|orig|sql|sh|ini|dist|lock|tmp)$ - [F,L,NC]

# красивые адреса
RewriteRule ^news/?$ news.php [L]
RewriteRule ^news/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^consent/?$ /privacy [R=301,L]   # отдельной страницы согласия нет — всё в политике
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
# после перехода на HTTPS раскомментировать:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
# стили и скрипты подключаются с номером версии (?v=…), поэтому их можно хранить долго
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType image/webp "access plus 1 month"
</IfModule>

# страницы — всегда свежие: браузер каждый раз проверяет, не изменились ли они
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
