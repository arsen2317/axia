# Загруженные картинки: никакие скрипты здесь не выполняются
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Deny from all
</IfModule>
</FilesMatch>
<IfModule mod_php.c>
php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
